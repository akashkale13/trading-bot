KITE_MCP_URL=https://mcp.kite.trade/mcp
KITE_MCP_QUOTE_TOOL=get_quote
KITE_MCP_ORDER_TOOL=place_order

ENABLE_LIVE_TRADING=false
ENVIRONMENT=development

# Optional: if you later integrate an LLM-based decision layer
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Default strategy selection controls
DEFAULT_STRATEGY=trend_following
STRATEGY_MODE=rule_based

# Risk controls
MAX_POSITION_SIZE=1
MAX_DAILY_LOSS_PERCENT=2.0
MAX_DRAWDOWN_PERCENT=5.0

# Market / symbol config
WATCHLIST=NIFTY 50,RELIANCE,INFY
ALERT_SYMBOL=NIFTY 50

# Execution parameters
ORDER_TYPE=LIMIT
QUANTITY=1
TTL_SECONDS=60
